{
  "schemaVersion": 39,
  "title": "Alora Agent",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(instance)"
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": "${DS_PROMETHEUS}",
        "query": "label_values(pod)"
      }
    ]
  },
  "panels": [
    {
      "title": "Trafik (so'rov/s)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(alora_chat_requests_total{instance=~\"$instance\",pod=~\"$pod\"}[5m])) by (status)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Xato ulushi (%)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(alora_chat_requests_total{status!=\"ok\",instance=~\"$instance\",pod=~\"$pod\"}[5m])) / sum(rate(alora_chat_requests_total{instance=~\"$instance\",pod=~\"$pod\"}[5m])) * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      }
    },
    {
      "title": "Faol sessiyalar",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(alora_active_sessions{instance=~\"$instance\",pod=~\"$pod\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      }
    },
    {
      "title": "Javob vaqti p50/p95/p99",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "\nhistogram_quantile(0.99, sum(rate(alora_response_seconds_bucket{instance=~\"$instance\",pod=~\"$pod\"}[5m])) by (le))\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      }
    },
    {
      "title": "LLM Token/s",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(alora_llm_tokens_total{instance=~\"$instance\",pod=~\"$pod\"}[5m])) by (kind, provider)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      }
    },
    {
      "title": "LLM Fallback (o'sish)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(increase(alora_llm_fallback_total{instance=~\"$instance\",pod=~\"$pod\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      }
    },
    {
      "title": "Tool chaqiruv/s",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(alora_tool_seconds_count{instance=~\"$instance\",pod=~\"$pod\"}[5m])) by (tool)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      }
    },
    {
      "title": "Tool xato ulushi",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(alora_tool_errors_total{instance=~\"$instance\",pod=~\"$pod\"}[5m])) by (tool) / sum(rate(alora_tool_seconds_count{instance=~\"$instance\",pod=~\"$pod\"}[5m])) by (tool)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      }
    },
    {
      "title": "Tool davomiylik p95",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(alora_tool_seconds_bucket{instance=~\"$instance\",pod=~\"$pod\"}[5m])) by (le, tool))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      }
    },
    {
      "title": "Katalog Age",
      "type": "stat",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "max(alora_catalog_age_seconds{instance=~\"$instance\",pod=~\"$pod\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        }
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      }
    },
    {
      "title": "Katalog Watch Connected",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "min(alora_catalog_watch_connected{instance=~\"$instance\",pod=~\"$pod\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      }
    },
    {
      "title": "Katalog Version",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "max(alora_catalog_version{instance=~\"$instance\",pod=~\"$pod\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      }
    },
    {
      "title": "Outbox Pending",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(alora_outbox_pending{instance=~\"$instance\",pod=~\"$pod\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      }
    },
    {
      "title": "Outbox Dead",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(alora_outbox_dead_total{instance=~\"$instance\",pod=~\"$pod\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      }
    },
    {
      "title": "Ovoz STT p95",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(alora_voice_stt_seconds_bucket{instance=~\"$instance\",pod=~\"$pod\"}[5m])) by (le))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      }
    },
    {
      "title": "Ovoz TTS (belgi/s)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(alora_voice_tts_chars{instance=~\"$instance\",pod=~\"$pod\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 40
      }
    },
    {
      "title": "Goroutines",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(go_goroutines{instance=~\"$instance\",pod=~\"$pod\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 17,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 40
      }
    },
    {
      "title": "Xotira (RAM)",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(process_resident_memory_bytes{instance=~\"$instance\",pod=~\"$pod\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "id": 18,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 40
      }
    },
    {
      "title": "GC Duration p95",
      "type": "timeseries",
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(go_gc_duration_seconds_bucket{instance=~\"$instance\",pod=~\"$pod\"}[5m])) by (le))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "id": 19,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 48
      }
    }
  ]
}